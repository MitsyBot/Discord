generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id             String   @id @default("790760362060283974") @db.VarChar(255)
  maintenance  String[]

  @@map("mitsy_client")
}

model Background { 
  id String @id
  collection String
  title String
  rarity Int @default(1)
  authorId String
  price Float @db.DoublePrecision
  @@map("shop_backgrounds")
}

model DonationKeys {
  active_in  String
  user String @id
  value Float @db.DoublePrecision
  tier Int @default(1)
  expires_at DateTime
  metadata Json @db.Json
  @@map("premium_keys")
}

model Dailies {
  received_by String @db.VarChar(255) @id
  received_at DateTime @default(now())
  ip String @db.Text
  email String @db.Text
  user_agent String @db.VarChar(255)
  @@map("dailies")
}

model Reminders { 
  user String @id @db.VarChar(255)
  channel_id String @db.VarChar(255)
  remind_at DateTime 
  content String @db.Text
  @@map("reminders")
}

model Payments {
  user String @db.VarChar(255)
  gateway String
  reason String @db.Text
  money Float
  created_at DateTime @default(now())
  paid Boolean @default(false)
  paid_at DateTime
  expires_at DateTime
  reference_id String @db.Uuid @id
  metadata Json @db.Json
  @@map("premium_payments")
}

model Reputations {
  given_by String @id @db.VarChar(255)
  given_by_ip String @db.Text
  given_by_email String @db.Text
  received_by String @db.VarChar(255)
  received_at DateTime @default(now())
  content String @db.Text
  @@map("reputations")
}

model UserAchievements {
  user String @id @db.VarChar(255)
  type String
  achieved_at String
  @@map("achievements")
}

model Fanarts {
  user String @id @db.VarChar(255)
  id Int @default(0)
  name String @db.Text
  @@map("mitsy_fanarts")
}

model Colors {
  id String @id @db.Text
  cost Int @default(0)
  @@map("shop_colors")
}

model BlacklistedGuilds {
  guild String @id
  bannedAt DateTime @default(now())
  reason String @db.Text
  @@map("blacklisted_guilds")
}

model BannedUsers {
  user String @id
  valid Boolean @default(true)
  banned_at DateTime @default(now())
  expires_at Float
  reason String @db.Text
  banned_by String @db.Text
  @@map("banned_users")
}

// User config (website and bot)

model UserConnections {
  id String   @id @db.VarChar(255)
  name String
  tokens String[]
  config String[]
  @@map("user_connections")
}

model UserProfile {
  id String
  user UserGeneralConfig @relation(fields: [id], references: [id])
  comets Float @default(0)
  global_xp Float @default(0)
  global_level Float @db.DoublePrecision @default(90)
  aboutme String @db.Text @default("Mitsy é a minha melhor amiga, você pode mudar isto no seu perfil do meu website!")
  total_reps Float @db.DoublePrecision @default(0)
  active_background String @default("mitsy_1")
  backgrounds String[]
  active_profile_design String @default("default")
  profiles String[]
  active_badges String[]
  badge_list String[]
  active_colors String[]
  color String @default("#f895fb")
  isAfk Boolean @default(false)
  afkReason String @db.Text @default("")
  married Boolean @default(false)
  married_user String @default("")
  married_since Float @default(0) 
  gender String @default("UNKNOWN")
  @@id([id])

  @@map("user_profile")
}

model UserDonations {
    id String
    expire_at DateTime
    enabled_at DateTime
    tier Int @default(1)
    expired Boolean @default(false)
    @@id([id])
    @@map("user_donations")
}

model UserCooldowns {
  id String
  last_daily Float @default(0)
  last_rep Float @default(0)
  user UserGeneralConfig @relation(fields: [id], references: [id])
  @@id([id])
  @@map("user_cooldowns")
}

model UserGeneralConfig {
  id String
  profile UserProfile?
  cooldowns UserCooldowns?
  locale String @default("pt-BR")
  @@id([id])
  @@map("user_config")
}

// Guild config (website and bot)

model GuildProfile {
  guild String
  user String
  xp Float
  level Float
  isInGuild Boolean @default(true)
  @@id([user])
  @@map("guild_profiles")
}

model GuildConfig {
  id String
  blacklisted_channels String[]
  custom_commands String[]
  disabled_commands String[]
  lang String @default("pt-BR")
  prefix String @default("-")
  custom_warn_message Boolean @default(false)
  blacklisted_warning String @default("Este canal esta bloqueado de usar meus comandos!")
  @@id([id])
  @@map("guild_general")
}