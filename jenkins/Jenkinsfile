pipeline {
  agent any
  environment {
    GITHUB_TOKEN=credentials('github-token')
    IMAGE_NAME='mitsybot/discord-canary'
    IMAGE_VERSION='latest'
  }
  stages {
    stage('cleanup') {
      steps {
        sh 'docker system prune -a --volumes --force'
      }
    }
    stage('build image') {
      steps {
        sh 'docker build -t $IMAGE_NAME:$IMAGE_VERSION .'
      }
    }
    stage('login to GHCR') {
      steps {
        sh 'echo $GITHUB_TOKEN_PSW | docker login ghcr.io -u $GITHUB_TOKEN_USR --password-stdin'
      }
    }
    stage('tag image') {
      steps {
        sh 'docker tag $IMAGE_NAME:$IMAGE_VERSION ghcr.io/$IMAGE_NAME:$IMAGE_VERSION'
      }
    }
    stage('push image') {
      steps {
        sh 'docker push ghcr.io/$IMAGE_NAME:$IMAGE_VERSION'
      }
    }
    stage('send to remote server') {
            steps {
          sshagent(credentials: ['ssh-credentials-id']) {
            sh '''
            docker stop discord-canary
            docker rm discord-canary
            docker image rm ghcr.io/mitsybot/discord-canary:latest
            docker pull ghcr.io/mitsybot/discord-canary:latest
            docker run -it -d -e SHARD_COUNT='1' -e BOT_TOKEN='${{ secrets.BOT_TOKEN }}' --name discord-canary ghcr.io/mitsybot/discord-canary:latest
            '''
          }
      }
    } 
  }
  post {
    always {
      sh 'docker logout'
    }
  }
}